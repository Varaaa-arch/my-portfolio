---
import '../styles/globals.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="flex gap-4 p-4">
      <a href="/">Home</a>
      <a href="/projects">Projects</a>
      <a href="/lab">Lab</a>
      <a href="/research">Research</a>
    </nav>
    <slot />
  </body>
</html>