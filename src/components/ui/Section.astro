---
import Container from './Container.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  class?: string;
}
const { id, eyebrow, title, class: className = '' } = Astro.props;
const titleId = id && title ? `${id}-title` : undefined;
---
<section
  id={id}
  aria-labelledby={titleId}
  class:list={['scroll-mt-16 py-[var(--section-y)]', className]}
>
  <Container>
    {(eyebrow || title) && (
      <header class="mb-lg">
        {eyebrow && (
          <p class="mb-xs font-mono text-small uppercase tracking-widest text-accent">{eyebrow}</p>
        )}
        {title && <h2 id={titleId} class="font-display text-heading">{title}</h2>}
      </header>
    )}
    <slot />
  </Container>
</section>
